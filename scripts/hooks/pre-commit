#!/usr/bin/env bash
# Versioned pre-commit hook (enabled by scripts/install-hooks.sh via core.hooksPath).
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ "${KB_SKIP_GITLEAKS:-0}" = "1" ]; then
  echo "WARNING: KB_SKIP_GITLEAKS=1, skipping the staged secret scan." >&2
elif ! command -v gitleaks >/dev/null 2>&1; then
  {
    echo "ERROR: gitleaks (8.19 or newer) is required to commit to this KB."
    echo "  macOS:   brew install gitleaks"
    echo "  Windows: scoop install gitleaks   (or: winget install gitleaks)"
    echo "  Linux:   download a release from https://github.com/gitleaks/gitleaks/releases"
    echo "  One-off bypass (not recommended): KB_SKIP_GITLEAKS=1 git commit ..."
  } >&2
  exit 1
else
  gitleaks git --staged --redact --no-banner --log-level warn -v --config "$ROOT/.gitleaks.toml"
fi

# Check what is being committed, not the working tree: export the staged tree
# (the index git commits from; it honours GIT_INDEX_FILE, so `git commit -- <path>`
# works too). Untracked or unstaged pages never reach INDEX.md or the checks.
STAGED="$(mktemp -d "${TMPDIR:-/tmp}/kb-staged.XXXXXX")"
trap 'rm -rf "$STAGED"' EXIT
git checkout-index -a -f --prefix="$STAGED/"

python3 scripts/rebuild-indexes.py --root "$STAGED" >/dev/null
if ! git show :INDEX.md 2>/dev/null | cmp -s - "$STAGED/INDEX.md"; then
  cp "$STAGED/INDEX.md" INDEX.md
  git add INDEX.md
fi
python3 scripts/kb-lint.py --staged --root "$STAGED"
python3 scripts/reminder-ledger-check.py --root "$STAGED" >/dev/null
if ! python3 scripts/wikilink-check.py --root "$STAGED" >/dev/null; then
  echo "WARNING: wikilink-check found missing targets in the staged tree (warning only; run python3 scripts/wikilink-check.py)." >&2
fi
